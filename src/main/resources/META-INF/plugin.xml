<idea-plugin require-restart="false"
             url="https://github.com/alexBlakeGoudemond/jetbrains-kudos">

    <id>Kudos</id>
    <name>Kudos</name>

    <vendor email="alexgoudemond@gmail.com">Alex Blake-Goudemond</vendor>

    <description><![CDATA[
        Simple JetBrains Plugin; when it comes to commits - give credit where credit is due!
        <br/><br/>
        Kudos makes it easy to give credit to contributors when committing changes through a
        JetBrains IDE - whether that's a teammate, an open-source project, or an AI Agent.
    ]]></description>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- com.intellij.modules.platform is the minimal dependency every plugin needs.
         We'll add com.intellij.modules.vcs / Git4Idea in a later step once we build
         the actual commit-checkbox integration. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Extension points (commit handler, tool window, settings service)
             will be registered here in later steps. -->

<!--        <toolWindow id="Kudos"-->
<!--                    factoryClass="..."-->
<!--                    icon="/META-INF/plugin-icon-simple.svg"-->
<!--                    anchor="left"-->
<!--                    doNotActivateOnStart="true"/>-->
    </extensions>
</idea-plugin>
